# SkillSync Environment Variables Template
# Copy this file to .env and fill in your credentials

# Supabase Cloud Database Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-publishable-or-anon-key
SUPABASE_REST_URL=https://your-project-ref.supabase.co/rest/v1

# Cloud Database Enablement Flag (set to 'true' to enable cloud sync)
USE_SUPABASE=true

# Flask Application Secret Key
SECRET_KEY=your-flask-secret-key-here
